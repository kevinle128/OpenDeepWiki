<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Local host for browser end-to-end tests. It starts the real application on a fixed loopback port
    with a temporary SQLite database and an in-process fake Git provider. It is not part of the product build.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>OpenDeepWiki.E2EHost</RootNamespace>
    <!-- The test-only package version stays here so the shared package list is unchanged. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenDeepWiki\OpenDeepWiki.csproj">
      <ExcludeAssets>analyzers</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
